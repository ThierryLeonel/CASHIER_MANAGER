#, python-format
msgid ""
"%(a)s cannot be transferred into %(b)s. Transfer the same product (cash ↔ "
"bank is allowed)."
msgstr ""
"%(a)s ne peut pas être transféré vers %(b)s. Transférez le même produit "
"(espèces ↔ banque est permis)."

#, python-format
msgid ""
"%(acct)s already has an opening balance (%(ref)s). Use a correction to "
"change it."
msgstr ""
"%(acct)s a déjà un solde d'ouverture (%(ref)s). Utilisez une correction pour"
" le modifier."

#, python-format
msgid "%(acct)s: enter a whole FCFA amount."
msgstr "%(acct)s : saisissez un montant entier en FCFA."

#, python-format
msgid "%(agent)s owes the shop only %(owed)s FCFA."
msgstr "%(agent)s ne doit à la boutique que %(owed)s FCFA."

#, python-format
msgid ""
"%(cm)s already has exchanges, so it cannot be deleted. Untick Active to stop"
" using it; its history stays."
msgstr ""
"%(cm)s a déjà des échanges : impossible de le supprimer. Décochez Active "
"pour ne plus l'utiliser ; son historique reste."

#, python-format
msgid "%(cp)s is inactive."
msgstr "%(cp)s est inactif."

#, python-format
msgid "%(cp)s is not a %(kind)s."
msgstr "%(cp)s n'est pas : %(kind)s."

#, python-format
msgid "%(cp)s registered."
msgstr "%(cp)s enregistré."

#, python-format
msgid "%(i)s is no longer sold."
msgstr "%(i)s n'est plus vendu."

#, python-format
msgid "%(label)s is required."
msgstr "%(label)s est obligatoire."

#, python-format
msgid "%(label)s: invalid number %(v)s"
msgstr "%(label)s : numéro invalide %(v)s"

#, python-format
msgid "%(mz)s is already controlled by %(agent)s."
msgstr "%(mz)s est déjà contrôlée par %(agent)s."

#, python-format
msgid "%(n)s SIM(s)"
msgstr "%(n)s SIM"

#, python-format
msgid "%(n)s cash drawer(s)"
msgstr "%(n)s caisse(s)"

#, python-format
msgid "%(n)s cashier(s)"
msgstr "%(n)s caissier(s)"

#, python-format
msgid "%(n)s microzone(s)"
msgstr "%(n)s microzone(s)"

#, python-format
msgid "%(n)s opening balances recorded, total %(amt)s FCFA."
msgstr "%(n)s soldes d'ouverture enregistrés, total %(amt)s FCFA."

#, python-format
msgid "%(n)s rows imported."
msgstr "%(n)s lignes importées."

#, python-format
msgid "%(n)s shops"
msgstr "%(n)s boutiques"

#, python-format
msgid "%(n)s unit(s) received into stock."
msgstr "%(n)s unité(s) reçue(s) en stock."

#, python-format
msgid ""
"%(party)s currently owes %(owed)s FCFA, less than the %(amt)s FCFA of "
"%(ref)s. Part of it is already settled, so the full supply cannot be "
"transferred without moving settled debt. A manager must decide how to handle"
" this case."
msgstr ""
"%(party)s doit actuellement %(owed)s FCFA, moins que les %(amt)s FCFA de "
"%(ref)s. Une partie est déjà réglée : l'approvisionnement complet ne peut "
"pas être transféré sans déplacer une dette réglée. Un responsable doit "
"décider comment traiter ce cas."

#, python-format
msgid "%(ref)s has already been corrected."
msgstr "%(ref)s a déjà été corrigée."

#, python-format
msgid "%(ref)s marked CORRECTED."
msgstr "%(ref)s marquée CORRIGÉE."

#, python-format
msgid ""
"%(ref)s resolves a closing difference. Reopen or keep it; it cannot be "
"deleted."
msgstr "%(ref)s résout un écart de clôture ; elle ne peut pas être supprimée."

#, python-format
msgid "%(ref)s updated. The previous values are kept in the audit log."
msgstr ""
"%(ref)s modifiée. Les anciennes valeurs sont conservées dans le journal "
"d'audit."

#, python-format
msgid "%(s)s is not a %(item)s."
msgstr "%(s)s n'est pas un(e) %(item)s."

#, python-format
msgid "%(s)s is not in stock at %(shop)s for this item."
msgstr "%(s)s n'est pas en stock à %(shop)s pour cet article."

#, python-format
msgid "%(s)s removed from stock."
msgstr "%(s)s retiré du stock."

#, python-format
msgid "%(s)s — reconciliation of %(d)s"
msgstr "%(s)s — rapprochement du %(d)s"

#, python-format
msgid ""
"%(shop)s has recorded operations, stock or services, so it cannot be "
"deleted. Untick Active to close it; its history stays in the reports."
msgstr ""
"%(shop)s a des opérations, du stock ou des services enregistrés : elle ne "
"peut pas être supprimée. Décochez Active pour la fermer ; son historique "
"reste dans les rapports."

#, python-format
msgid ""
"%(shop)s still has %(n)s staff account(s). Move them to another shop first, "
"or deactivate the shop."
msgstr ""
"%(shop)s a encore %(n)s compte(s) du personnel. Affectez-les d'abord à une "
"autre boutique, ou désactivez la boutique."

#, python-format
msgid "%(type)s %(ref)s recorded: %(amt)s FCFA."
msgstr "%(type)s %(ref)s enregistré(e) : %(amt)s FCFA."

#, python-format
msgid "%(u)s can sign in again."
msgstr "%(u)s peut de nouveau se connecter."

#, python-format
msgid "%(u)s has an open shift. It must be closed before the transfer."
msgstr "%(u)s a un service ouvert. Il doit être fermé avant la mutation."

#, python-format
msgid ""
"%(u)s has recorded operations, so the account cannot be deleted. Deactivate "
"it instead; the records keep the name."
msgstr ""
"%(u)s a enregistré des opérations : le compte ne peut pas être supprimé. "
"Désactivez-le ; les enregistrements gardent le nom."

#, python-format
msgid "%(u)s is deactivated and can no longer sign in."
msgstr "%(u)s est désactivé et ne peut plus se connecter."

#, python-format
msgid "%(x)s deleted."
msgstr "%(x)s supprimé."

#, python-format
msgid ""
"%(x)s is already used in records, so it cannot be deleted. Untick Active to "
"remove it from the lists."
msgstr ""
"%(x)s est déjà utilisé dans des enregistrements : impossible de le "
"supprimer. Décochez Active pour le retirer des listes."

#, python-format
msgid "%(z)s desk · entries go to business day %(d)s"
msgstr "Poste %(z)s · saisies sur la journée du %(d)s"

#, python-format
msgid ""
"%(z)s is a subzone of %(p)s. Select a master zone, or open Zones and clear "
"the master zone of %(z)s."
msgstr ""
"%(z)s est une sous-zone de %(p)s. Choisissez une zone master, ou ouvrez "
"Zones et videz la zone master de %(z)s."

#, python-format
msgid ""
"%(z)s still has zones under it (%(names)s). A subzone cannot have subzones: "
"open each of them and choose a master zone or make it a master zone, then "
"come back."
msgstr ""
"%(z)s a encore des zones en dessous (%(names)s). Une sous-zone ne peut pas "
"avoir de sous-zones : ouvrez chacune d'elles et choisissez une zone master "
"ou faites-en une zone master, puis revenez."

msgid "(stored encrypted, cannot be shown)"
msgstr "(stocké chiffré, ne peut pas être affiché)"

msgid ""
"(you already closed today; new entries belong to the next business day)"
msgstr ""
"(vous avez déjà clôturé aujourd'hui ; les nouvelles saisies appartiennent à "
"la journée suivante)"

msgid "..."
msgstr "..."

msgid ""
"1:1 exchanges of cash and UVE, no fees. Never sales, revenue or expenses."
msgstr ""
"Échanges 1:1 d'espèces et d'UVE, sans frais. Jamais des ventes, recettes ou "
"dépenses."

msgid "A POS belongs to a microzone: choose it or create it."
msgstr "Un PDV appartient à une microzone : choisissez-la ou créez-la."

msgid "A balance cannot be negative."
msgstr "Un solde ne peut pas être négatif."

msgid "A capital movement can only be cancelled, then recorded again."
msgstr ""
"Un mouvement de capital ne peut qu'être annulé, puis enregistré à nouveau."

msgid "A cashier must belong to a subzone."
msgstr "Un caissier doit appartenir à une sous-zone."

msgid ""
"A cashier's cash drawer or UVE wallet, a master SIM, a bank account or a "
"shop account."
msgstr ""
"La caisse ou le portefeuille UVE d'un caissier, une SIM maître, un compte "
"bancaire ou un compte de boutique."

msgid ""
"A change applies to future conversions only; each conversion stores the rate"
" it used."
msgstr ""
"Un changement ne s'applique qu'aux conversions futures ; chaque conversion "
"conserve le taux utilisé."

msgid "A company drawer/wallet/bank cannot open negative."
msgstr ""
"Une caisse, un portefeuille ou une banque de l'entreprise ne peut pas ouvrir"
" en négatif."

msgid ""
"A completed move between company accounts of the same kind: MTN float, UVE "
"or bank. No customer is affected."
msgstr ""
"Un mouvement effectué entre comptes de l'entreprise du même type : float "
"MTN, UVE ou banque. Aucun client n'est concerné."

msgid ""
"A completed move of cash or electronic value between company accounts. No "
"customer is affected."
msgstr ""
"Un mouvement effectué d'espèces ou de valeur électronique entre comptes de "
"l'entreprise. Aucun client n'est concerné."

msgid "A correction reason is required."
msgstr "Le motif de la correction est obligatoire."

msgid ""
"A different responsible party is only allowed when a POS receives the supply"
" and it is explicitly assigned to a commercial agent."
msgstr ""
"Un autre responsable n'est permis que si un PDV reçoit l'approvisionnement "
"et qu'il est explicitement attribué à un agent commercial."

msgid "A junior manager must be assigned the zone they supervise."
msgstr "Un manager junior doit être affecté à la zone qu'il supervise."

msgid "A microzone belongs to a subzone, not to a master zone."
msgstr "Une microzone appartient à une sous-zone, pas à une zone master."

msgid "A responsibility transfer can only be cancelled, then recorded again."
msgstr ""
"Un transfert de responsabilité peut seulement être annulé, puis ressaisi."

msgid "A shop manager must be assigned a shop."
msgstr "Un gérant de boutique doit être affecté à une boutique."

msgid "A subzone's parent must be a master zone."
msgstr "Le parent d'une sous-zone doit être une zone principale."

msgid "A zone cannot be its own master zone."
msgstr "Une zone ne peut pas être sa propre zone master."

msgid "A4 receipt / print"
msgstr "Reçu A4 / imprimer"

msgid "AG"
msgstr "AG"

