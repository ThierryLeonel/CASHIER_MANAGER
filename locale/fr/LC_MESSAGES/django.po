msgid "This transaction has been corrected; transfer its replacement instead."
msgstr ""
"Cette transaction a été corrigée ; transférez plutôt son remplacement."

msgid "This transaction has no customer obligation."
msgstr "Cette transaction ne comporte aucune obligation client."

