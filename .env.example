# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=cashier.example.cm,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://cashier.example.cm
# Set to 1 only when running locally over plain http with DEBUG=0
DJANGO_INSECURE_COOKIES=0

DB_NAME=cashier
DB_USER=cashier
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

COMPANY_NAME=Orange Distribution Partner
COMPANY_ADDRESS=Buea / Limbe / Kumba, Cameroon
